<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.EnrollmentController">

    <padding>
        <Insets bottom="28.0" left="28.0" right="28.0" top="28.0"/>
    </padding>

    <Label styleClass="page-title" text="Enrollment"/>

    <Label styleClass="page-subtitle"
           text="Enroll students in subjects and sections, or drop a subject."/>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <TextField fx:id="searchField"
                   promptText="Search student no., name, or subject"
                   HBox.hgrow="ALWAYS"/>

        <ComboBox fx:id="schoolYearCombo" prefWidth="140.0"/>
        <ComboBox fx:id="statusCombo" prefWidth="140.0"/>

        <Button onAction="#handleRefresh"
                styleClass="btn-secondary"
                text="Refresh"/>
    </HBox>

    <TableView fx:id="enrollmentTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="studentNoColumn"
                         prefWidth="95.0"
                         text="Student No."/>

            <TableColumn fx:id="studentNameColumn"
                         prefWidth="170.0"
                         text="Student"/>

            <TableColumn fx:id="subjectColumn"
                         prefWidth="210.0"
                         text="Subject"/>

            <TableColumn fx:id="sectionColumn"
                         prefWidth="80.0"
                         text="Section"/>

            <TableColumn fx:id="schoolYearColumn"
                         prefWidth="90.0"
                         text="School Year"/>

            <TableColumn fx:id="gradeLevelColumn"
                         prefWidth="80.0"
                         text="Grade Level"/>

            <TableColumn fx:id="dateColumn"
                         prefWidth="95.0"
                         text="Enrolled On"/>

            <TableColumn fx:id="statusColumn"
                         prefWidth="90.0"
                         text="Status"/>
        </columns>

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Label fx:id="countLabel"
               maxWidth="Infinity"
               styleClass="page-subtitle"
               HBox.hgrow="ALWAYS"/>

        <Button onAction="#handleDrop"
                prefHeight="38.0"
                prefWidth="140.0"
                styleClass="btn-secondary"
                text="Drop Subject"/>

        <Button onAction="#handleEnroll"
                prefHeight="38.0"
                prefWidth="150.0"
                styleClass="btn-primary"
                text="Enroll Student"/>
    </HBox>

</VBox>