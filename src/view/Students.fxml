<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.StudentsController">
    <padding>
        <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
    </padding>

    <Label styleClass="page-title" text="Students" />
    <Label styleClass="page-subtitle" text="Manage student records. Double-click a row to edit." />

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <TextField fx:id="searchField" promptText="Search student no. or name" HBox.hgrow="ALWAYS" />
        <ComboBox fx:id="statusCombo" prefWidth="160.0" />
        <Button onAction="#handleRefresh" styleClass="btn-secondary" text="Refresh" />
    </HBox>

    <TableView fx:id="studentsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="studentNoColumn" prefWidth="100.0" text="Student No." />
            <TableColumn fx:id="nameColumn" prefWidth="220.0" text="Name" />
            <TableColumn fx:id="genderColumn" prefWidth="70.0" text="Gender" />
            <TableColumn fx:id="contactColumn" prefWidth="110.0" text="Contact No." />
            <TableColumn fx:id="addressColumn" prefWidth="260.0" text="Address" />
            <TableColumn fx:id="statusColumn" prefWidth="90.0" text="Status" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Label fx:id="countLabel" maxWidth="Infinity" styleClass="page-subtitle" HBox.hgrow="ALWAYS" />
        <Button onAction="#handleChangeStatus" prefHeight="38.0" prefWidth="140.0" styleClass="btn-secondary" text="Change Status" />
        <Button onAction="#handleEdit" prefHeight="38.0" prefWidth="110.0" styleClass="btn-secondary" text="Edit" />
        <Button onAction="#handleAdd" prefHeight="38.0" prefWidth="140.0" styleClass="btn-primary" text="Add Student" />
    </HBox>
</VBox>