<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="1080.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DashboardController">
    <stylesheets>
        <URL value="@app.css" />
        <URL value="@dashboard.css" />
    </stylesheets>

    <left>
        <VBox prefWidth="230.0" spacing="6.0" styleClass="sidebar">
            <padding>
                <Insets bottom="20.0" left="14.0" right="14.0" top="24.0" />
            </padding>
            <Label styleClass="sidebar-brand" text="🎓 Registrar Panel" />
            <Label fx:id="userNameLabel" styleClass="sidebar-user" />
            <Region prefHeight="18.0" />
            <Button fx:id="navHomeButton" maxWidth="Infinity" onAction="#showHome" styleClass="nav-button" text="Overview" />
            <Button fx:id="navStudentsButton" maxWidth="Infinity" onAction="#showStudents" styleClass="nav-button" text="Students" />
            <Button fx:id="navEnrollmentButton" maxWidth="Infinity" onAction="#showEnrollment" styleClass="nav-button" text="Enrollment" />
            <Button fx:id="navRequestsButton" maxWidth="Infinity" onAction="#showRequests" styleClass="nav-button" text="Document Requests" />
            <Region VBox.vgrow="ALWAYS" />
            <Button maxWidth="Infinity" onAction="#handleLogout" styleClass="nav-button, nav-button-logout" text="Log Out" />
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" styleClass="content-area" />
    </center>
</BorderPane>