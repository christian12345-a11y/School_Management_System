<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER"
      prefWidth="720.0"
      spacing="14.0"
      styleClass="page"
      stylesheets="@app.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.EnrollFormController">

    <padding>
        <Insets bottom="25.0"
                left="35.0"
                right="35.0"
                top="25.0"/>
    </padding>

    <Label styleClass="page-title" text="Enroll Student"/>

    <VBox styleClass="card">
        <GridPane hgap="14.0" vgap="12.0">

            <columnConstraints>
                <ColumnConstraints prefWidth="110.0"/>
                <ColumnConstraints hgrow="ALWAYS" prefWidth="220.0"/>
                <ColumnConstraints prefWidth="110.0"/>
                <ColumnConstraints hgrow="ALWAYS" prefWidth="220.0"/>
            </columnConstraints>

            <Label styleClass="field-label"
                   text="STUDENT *"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="0"
                   GridPane.valignment="TOP"/>

            <VBox spacing="4.0"
                  GridPane.columnIndex="1"
                  GridPane.columnSpan="3"
                  GridPane.rowIndex="0">

                <ComboBox fx:id="studentCombo"
                          editable="true"
                          maxWidth="Infinity"
                          promptText="Type student no. or name (e.g. eri)"/>

                <Label fx:id="searchHintLabel"
                       styleClass="page-subtitle"/>
            </VBox>

            <Label styleClass="field-label"
                   text="SCHOOL YEAR *"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="1"/>

            <TextField fx:id="schoolYearField"
                       promptText="2026-2027"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="1"/>

            <Label styleClass="field-label"
                   text="GRADE LEVEL *"
                   GridPane.columnIndex="2"
                   GridPane.rowIndex="1"/>

            <ComboBox fx:id="gradeLevelCombo"
                      maxWidth="Infinity"
                      promptText="Select"
                      GridPane.columnIndex="3"
                      GridPane.rowIndex="1"/>

            <Label styleClass="field-label"
                   text="SECTION *"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="2"/>

            <ComboBox fx:id="sectionCombo"
                      maxWidth="Infinity"
                      promptText="Select section"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="2"/>

            <Label styleClass="field-label"
                   text="DATE *"
                   GridPane.columnIndex="2"
                   GridPane.rowIndex="2"/>

            <DatePicker fx:id="enrollmentDatePicker"
                        maxWidth="Infinity"
                        GridPane.columnIndex="3"
                        GridPane.rowIndex="2"/>

            <Label styleClass="field-label"
                   text="SUBJECTS *"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="3"
                   GridPane.valignment="TOP"/>

            <ListView fx:id="subjectList"
                      prefHeight="190.0"
                      GridPane.columnIndex="1"
                      GridPane.columnSpan="3"
                      GridPane.rowIndex="3"/>

        </GridPane>
    </VBox>

    <Label styleClass="page-subtitle"
           text="* Required. Hold Ctrl and click to select more than one subject."/>

    <HBox alignment="CENTER" spacing="15.0">
        <Button fx:id="saveButton"
                onAction="#handleSave"
                prefHeight="40.0"
                prefWidth="180.0"
                styleClass="btn-primary"
                text="Enroll"/>

        <Button onAction="#handleCancel"
                prefHeight="40.0"
                prefWidth="180.0"
                styleClass="btn-secondary"
                text="Cancel"/>
    </HBox>

</VBox>