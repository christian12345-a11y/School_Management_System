<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefWidth="720.0" spacing="14.0" styleClass="page" stylesheets="@app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.StudentFormController">
    <padding>
        <Insets bottom="25.0" left="35.0" right="35.0" top="25.0" />
    </padding>

    <Label fx:id="titleLabel" styleClass="page-title" text="Add Student" />

    <VBox styleClass="card">
        <GridPane hgap="14.0" vgap="12.0">
            <columnConstraints>
                <ColumnConstraints prefWidth="100.0" />
                <ColumnConstraints hgrow="ALWAYS" prefWidth="220.0" />
                <ColumnConstraints prefWidth="110.0" />
                <ColumnConstraints hgrow="ALWAYS" prefWidth="220.0" />
            </columnConstraints>

            <Label styleClass="field-label" text="STUDENT NO. *" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="studentNoField" promptText="e.g. 2024-0001" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label styleClass="field-label" text="FIRST NAME *" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <TextField fx:id="firstNameField" GridPane.columnIndex="3" GridPane.rowIndex="0" />

            <Label styleClass="field-label" text="MIDDLE NAME" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="middleNameField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label styleClass="field-label" text="LAST NAME *" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <TextField fx:id="lastNameField" GridPane.columnIndex="3" GridPane.rowIndex="1" />

            <Label styleClass="field-label" text="SUFFIX" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="suffixField" promptText="Jr., III, etc." GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label styleClass="field-label" text="BIRTH DATE" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            <DatePicker fx:id="birthDatePicker" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="2" />

            <Label styleClass="field-label" text="GENDER" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <ComboBox fx:id="genderCombo" maxWidth="Infinity" promptText="Select" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Label styleClass="field-label" text="CONTACT NO." GridPane.columnIndex="2" GridPane.rowIndex="3" />
            <TextField fx:id="contactNoField" promptText="09XXXXXXXXX" GridPane.columnIndex="3" GridPane.rowIndex="3" />

            <Label styleClass="field-label" text="ADDRESS" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <TextField fx:id="addressField" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="4" />
        </GridPane>
    </VBox>

    <Label styleClass="page-subtitle" text="* Required" />

    <HBox alignment="CENTER" spacing="15.0">
        <Button fx:id="saveButton" onAction="#handleSave" prefHeight="40.0" prefWidth="180.0" styleClass="btn-primary" text="Save" />
        <Button onAction="#handleCancel" prefHeight="40.0" prefWidth="180.0" styleClass="btn-secondary" text="Cancel" />
    </HBox>
</VBox>