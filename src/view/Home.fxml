<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_LEFT" spacing="18.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.HomeController">
    <padding>
        <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
    </padding>

    <Label styleClass="page-title" text="Overview" />
    <Label styleClass="page-subtitle" text="Summary of document requests and students." />

    <HBox spacing="16.0">
        <VBox maxWidth="Infinity" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="pendingLabel" styleClass="stat-number" text="0" />
            <Label styleClass="stat-caption" text="Pending Requests" />
        </VBox>
        <VBox maxWidth="Infinity" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="approvedLabel" styleClass="stat-number" text="0" />
            <Label styleClass="stat-caption" text="Approved Requests" />
        </VBox>
        <VBox maxWidth="Infinity" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="rejectedLabel" styleClass="stat-number" text="0" />
            <Label styleClass="stat-caption" text="Rejected Requests" />
        </VBox>
        <VBox maxWidth="Infinity" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="studentsLabel" styleClass="stat-number" text="0" />
            <Label styleClass="stat-caption" text="Active Students" />
        </VBox>
    </HBox>
</VBox>