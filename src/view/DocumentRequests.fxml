<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DocumentRequestsController">
    <padding>
        <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
    </padding>

    <Label styleClass="page-title" text="Document Requests" />
    <Label styleClass="page-subtitle" text="Review and process document requests from students." />

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <TextField fx:id="searchField" promptText="Search student no., name, or document" HBox.hgrow="ALWAYS" />
        <ComboBox fx:id="statusCombo" prefWidth="160.0" />
        <Button onAction="#handleRefresh" styleClass="btn-secondary" text="Refresh" />
    </HBox>

    <TableView fx:id="requestsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="studentNoColumn" prefWidth="100.0" text="Student No." />
            <TableColumn fx:id="studentNameColumn" prefWidth="190.0" text="Student" />
            <TableColumn fx:id="documentColumn" prefWidth="160.0" text="Document" />
            <TableColumn fx:id="purposeColumn" prefWidth="160.0" text="Purpose" />
            <TableColumn fx:id="requestedAtColumn" prefWidth="130.0" text="Requested" />
            <TableColumn fx:id="statusColumn" prefWidth="90.0" text="Status" />
            <TableColumn fx:id="processedByColumn" prefWidth="130.0" text="Processed By" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Label fx:id="countLabel" maxWidth="Infinity" styleClass="page-subtitle" HBox.hgrow="ALWAYS" />
        <Button onAction="#handleReject" prefHeight="38.0" prefWidth="120.0" styleClass="btn-secondary" text="Reject" />
        <Button onAction="#handleApprove" prefHeight="38.0" prefWidth="120.0" styleClass="btn-primary" text="Approve" />
    </HBox>
</VBox>